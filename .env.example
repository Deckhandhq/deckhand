# Public domain served by Caddy. Use "localhost" for a local trial.
DEKHAND_DOMAIN=dekhand.example.com

# PostgreSQL password. Generate it with `openssl rand -base64 32`.
POSTGRES_PASSWORD=change-me-please
POSTGRES_USER=dekhand
POSTGRES_DB=dekhand

# Image tag to use. Pin a specific version in production.
DEKHAND_VERSION=latest
