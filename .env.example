# ---------- Production (VPS / Docker Hub) ----------
DOCKERHUB_USER=epitexam
DECKHAND_VERSION=latest

# Domaine public (Caddy obtient le TLS automatiquement)
DOMAIN=example.com
ORIGIN=https://example.com

# PostgreSQL — éviter les caractères @ / # : ? dans le mot de passe
POSTGRES_DB=deckhand
POSTGRES_USER=deckhand
POSTGRES_PASSWORD=change-me

# À renseigner quand Better Auth sera activé
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://example.com

# ---------- Développement local (Bun) ----------
# Doit rester cohérent avec POSTGRES_* ci-dessus.
DATABASE_URL="postgresql://deckhand:deckhand@localhost:5432/deckhand?schema=public"
NODE_ENV=development
PORT=3000
CORS_ORIGIN="http://localhost:5173"
